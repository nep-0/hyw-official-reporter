# Heyinwu admin (read-only broadcast fetching)
HYW_ADMIN_USERNAME=
HYW_ADMIN_PASSWORD=
# Optional for shop-specific accounts; defaults to the login response's shop_id.
HYW_SHOP_ID=

# QQ official bot (required for -mode watch and -mode websocket)
QQ_BOT_APPID=
QQ_BOT_SECRET=
# Bot-specific group_openid from a QQ event, not a numeric QQ group number.
QQ_BOT_GROUP_OPENID=

# Heyinwu reverse WebSocket (required only for -mode websocket)
HYW_WS_TOKEN=
# Numeric QQ account configured as the reporter in Heyinwu.
HYW_WS_SELF_ID=
# Numeric incoming QQ group; map it to QQ_BOT_GROUP_OPENID above.
HYW_WS_GROUP_ID=
# Optional comma-separated extra bare hostnames for CQ image URLs.
# heyinwu.top and wechat.heyinwu.top are allowed by default.
HYW_WS_IMAGE_HOSTS=
